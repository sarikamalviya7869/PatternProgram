# Floyds Traingle
n = 5
num = 1
for i in range(1,n+1):
    for j in range(i):
        print(num,end= "")
        num += 1
    print()



# Hollow Sqaure
n = 5
for i in range(n):
    for j in range(n):
        if i == 0 or i == n-1 or j == 0 or j == n-1:
            print("*", end = " ")
        else:
            print(" ", end = " ")
    print()

#Pascal Triangle
n = 5
for i in range(n):
    print(" " * (n-i-1), end = " ")
    val = 1
    for j in range(i+1):
        print(val,end= " ")
        val = val * (i-j) // (j+1)
    print()

# Hollow Pyramid
n = 5
for i in range(1, n + 1):
    print(" " * (n - i), end="")
    for j in range(2 * i - 1):
        if j == 0 or j == 2 * i - 2 or i == n:
            print("*", end="")
        else:
            print(" ", end="")
    print()

# Right aligned traingle
n = 5
for i in range (1,n+1):
    print(" " * (n - i) + "*" * i)

#Butterfly pattern
n = 4

for i in range(1, n + 1):
    print("*" * i + " " * (2 * (n - i)) + "*" * i)
for i in range(n, 0, -1):
    print("*" * i + " " * (2 * (n - i)) + "*" * i)

