#Right Triangle
n = 5
for i in range(1,n+1):
    print("*" * i)

#Inverted Right Triangle
n = 5
for i in range(n,0,-1):
    print("*" * i)

#Pyramid
n = 5
for i in range(1,n+1):
    space = " " * (n-i)
    star = " * " * (2-i-1)
    print(space + star)


# Inverted Pyramid
n = 5
for i in range(n, 0, -1):
    space = " " * (n - i)
    star = "*" * (2 * i - 1)
    print(space + star)


# Print a diamond of stars
n = 5


for i in range(1, n + 1):
    space = " " * (n - i)
    star = "*" * (2 * i - 1)
    print(space + star)

for i in range(n - 1, 0, -1):
    space = " " * (n - i)
    star = "*" * (2 * i - 1)
    print(space + star)


